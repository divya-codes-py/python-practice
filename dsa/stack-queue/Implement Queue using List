# Problem: Create a Queue with enqueue, dequeue operations
# Queue = First In First Out (FIFO)

class Queue:
    def __init__(self):
        self.items = []  # Empty list to store items

    def enqueue(self, item):
        self.items.append(item)  # Add to back
        print(f"Enqueued: {item}")

    def dequeue(self):
        if self.is_empty():
            return "Queue is empty!"
        return self.items.pop(0)  # Remove from front

    def front(self):
        if self.is_empty():
            return "Queue is empty!"
        return self.items[0]  # See front without removing

    def is_empty(self):
        return len(self.items) == 0

    def size(self):
        return len(self.items)

# Test
q = Queue()
q.enqueue(10)
q.enqueue(20)
q.enqueue(30)
print(q.front())    # 10 (first element)
print(q.dequeue())  # 10 (removed)
print(q.dequeue())  # 20
print(q.size())     # 1
