# LeetCode 682 - Baseball Game
# Time Complexity: O(n)
# Space Complexity: O(n)

def cal_points(operations):

    stack = []

    for op in operations:

        if op == "+":
            stack.append(stack[-1] + stack[-2])

        elif op == "D":
            stack.append(2 * stack[-1])

        elif op == "C":
            stack.pop()

        else:
            stack.append(int(op))

    return sum(stack)


# Test
print(cal_points(["5", "2", "C", "D", "+"]))
