# LeetCode 71 - Simplify Path
# Time Complexity: O(n)
# Space Complexity: O(n)

def simplify_path(path):

    stack = []

    parts = path.split('/')

    for part in parts:

        if part == "" or part == ".":
            continue

        elif part == "..":

            if stack:
                stack.pop()

        else:
            stack.append(part)

    return "/" + "/".join(stack)


# Test
print(simplify_path("/home//foo/"))
