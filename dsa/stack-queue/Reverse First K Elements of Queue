# Reverse First K Elements of Queue
# Time Complexity: O(n)
from collections import deque

def reverse_k(q, k):
    if k <= 0 or k > len(q):   # edge case check
        return q
    
    stack = []
    
    # Step 1: Push first k to stack
    for _ in range(k):
        stack.append(q.popleft())
    
    # Step 2: Pop stack back to queue (reversed)
    while stack:
        q.append(stack.pop())
    
    # Step 3: Rotate remaining n-k elements to front
    for _ in range(len(q) - k):
        q.append(q.popleft())
    
    return q

# Test
q = deque([1, 2, 3, 4, 5])
print(reverse_k(q, 3))  # deque([3, 2, 1, 4, 5])
