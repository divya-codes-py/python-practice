# LeetCode 402 - Remove K Digits
# Time Complexity: O(n)
# Space Complexity: O(n)

def remove_k_digits(num, k):

    stack = []

    for digit in num:

        while k > 0 and stack and stack[-1] > digit:
            stack.pop()
            k -= 1

        stack.append(digit)

    while k > 0:
        stack.pop()
        k -= 1

    result = ''.join(stack).lstrip('0')

    return result if result else "0"


# Test
print(remove_k_digits("1432219", 3))
