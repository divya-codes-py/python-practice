# Problem: Find where two linked lists meet
# Output: Intersection node value or None

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

def find_intersection(head1, head2):
    visited = set()

    curr = head1
    while curr is not None:
        visited.add(curr)
        curr = curr.next

    curr = head2
    while curr is not None:
        if curr in visited:
            return curr.data  # Intersection found!
        curr = curr.next

    return None

# Test
common = Node(8)
common.next = Node(10)

head1 = Node(1)
head1.next = Node(2)
head1.next.next = common

head2 = Node(5)
head2.next = common

print(find_intersection(head1, head2))  # 8
