# Problem: Find the maximum number of consecutive 1s in the array
# Input:  [1, 1, 0, 1, 1, 1]
# Output: 3

def max_consecutive_ones(nums):
    max_count = 0    # Stores the overall maximum count
    curr_count = 0   # Stores the current streak of 1s

    for num in nums:
        if num == 1:
            curr_count += 1                  # Increase current streak
            if curr_count > max_count:
                max_count = curr_count       # Update max if needed
        else:
            curr_count = 0   # Reset streak when 0 is found

    return max_count

# Test
print(max_consecutive_ones([1, 1, 0, 1, 1, 1]))  # 3
print(max_consecutive_ones([1, 0, 1, 1, 0, 1]))  # 2
