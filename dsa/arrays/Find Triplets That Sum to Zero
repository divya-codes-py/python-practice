# Problem: Find all triplets that add up to zero
# Interview Question: "Find three numbers from the list that sum to 0"

def find_triplets(numbers):
    numbers.sort()
    triplets = []

    for i in range(len(numbers) - 2):
        left = i + 1
        right = len(numbers) - 1

        while left < right:
            total = numbers[i] + numbers[left] + numbers[right]

            if total == 0:
                triplet = [numbers[i], numbers[left], numbers[right]]
                if triplet not in triplets:
                    triplets.append(triplet)
                left += 1
                right -= 1
            elif total < 0:
                left += 1
            else:
                right -= 1

    return triplets


# Test
nums = [-1, 0, 1, 2, -1, -4]
result = find_triplets(nums)

print(f"List: {nums}")
print(f"Triplets summing to zero: {result}")
