# Problem: Merge two sorted linked lists
# Input:  1 -> 3 -> 5  and  2 -> 4 -> 6
# Output: 1 -> 2 -> 3 -> 4 -> 5 -> 6

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

def merge_sorted_lists(l1, l2):
    dummy = Node(0)  # Temporary start node
    curr = dummy

    while l1 is not None and l2 is not None:
        if l1.data <= l2.data:
            curr.next = l1
            l1 = l1.next
        else:
            curr.next = l2
            l2 = l2.next
        curr = curr.next

    if l1:
        curr.next = l1
    if l2:
        curr.next = l2

    return dummy.next

# Test
l1 = Node(1)
l1.next = Node(3)
l1.next.next = Node(5)

l2 = Node(2)
l2.next = Node(4)
l2.next.next = Node(6)

result = merge_sorted_lists(l1, l2)
curr = result
while curr:
    print(curr.data, end=" -> ")
    curr = curr.next
# Output: 1 -> 2 -> 3 -> 4 -> 5 -> 6
